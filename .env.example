# =============================================================================
# VAAHAN TRANSIT PORTAL - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local development or configure these in Vercel.
# =============================================================================

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (safe for client-side browser usage)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Gemini API Key for assistant features
GEMINI_API_KEY=

# Base URL where the portal is hosted
APP_URL=http://localhost:3000
